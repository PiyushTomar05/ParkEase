# Django Secret Key (Set a random secret string in production)
DJANGO_SECRET_KEY=django-insecure-7_mwim*z#an(tv+2f-*0_^n3l+lm&7=(_(n)8tspcpxr!sms1b

# Django Debug Mode (Set to True for development, False for production)
DJANGO_DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Email Backend (Optional, defaults to console backend)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Demo User Password (Used by 'python manage.py seed_demo_data')
PARKEASE_DEMO_PASSWORD=ParkEase@Demo2026
