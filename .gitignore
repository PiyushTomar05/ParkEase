# Python Bytecode & Compilation Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Node.js Dependencies (if frontend tooling is used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Local Secrets
.env
.env.*
!.env.example
*.env
local_settings.py

# Static Files Collection Directory
staticfiles/

# Local Logs & Diagnostics
*.log
logs/

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# IDE & Editor Specific Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# SQLite Database & Runtime Data
# Note: Cloned repositories should create fresh databases via:
#   python manage.py migrate
#   python manage.py seed_demo_data
*.sqlite3
*.sqlite3-journal
db.sqlite3
